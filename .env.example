# Copy to .env and adjust. .env is gitignored: never commit real keys.
# Values below match the local dev stack in compose.yaml (development-only credentials).

# ---------- LiveKit ----------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-devsecret

# ---------- Database ----------
RINGBRIDGE_DATABASE_URL=postgresql://ringbridge:ringbridge@localhost:5435/ringbridge

# ---------- Control plane (docs/control-plane.md) ----------
# RINGBRIDGE_HOST=127.0.0.1
# RINGBRIDGE_PORT=8088
# RINGBRIDGE_LOG_LEVEL=INFO
# RINGBRIDGE_LOG_JSON=true
# Agent workers authenticate to /internal routes with this (development value only).
RINGBRIDGE_WORKER_TOKEN=dev-worker-token-change-me
# RINGBRIDGE_WORKER_TOKEN_TTL_S=900
# RINGBRIDGE_AGENT_NAME=ringbridge

# ---------- Object storage (any S3-compatible service; ADR-0015) ----------
RINGBRIDGE_S3_ENDPOINT=http://localhost:8333
RINGBRIDGE_S3_BUCKET=ringbridge-recordings
RINGBRIDGE_S3_REGION=us-east-1
RINGBRIDGE_S3_ACCESS_KEY=ringbridge
RINGBRIDGE_S3_SECRET_KEY=ringbridge-dev-only

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4322
OTEL_SERVICE_NAME=ringbridge

# ---------- Host port overrides for the dev stack (defaults shown) ----------
# RINGBRIDGE_DB_PORT=5435
# RINGBRIDGE_REDIS_PORT=6385
# RINGBRIDGE_LIVEKIT_PORT=7880
# RINGBRIDGE_LIVEKIT_TCP_PORT=7881
# RINGBRIDGE_LIVEKIT_UDP_PORT=7882
# RINGBRIDGE_SIP_PORT=5060
# RINGBRIDGE_S3_PORT=8333
# RINGBRIDGE_JAEGER_UI_PORT=16688
# RINGBRIDGE_OTLP_GRPC_PORT=4321
# RINGBRIDGE_OTLP_HTTP_PORT=4322
# RINGBRIDGE_OLLAMA_PORT=11436
# RINGBRIDGE_SPEECH_PORT=8089

# ---------- Speech and LLM providers (docs/providers.md) ----------
# Development needs none of these: the `local` profile runs free models (uv run poe up-local).
# Already run Ollama yourself? Point at it instead of the container (no second model download):
# (default: the container at http://localhost:11436)
# RINGBRIDGE_OLLAMA_URL=http://localhost:11434
# RINGBRIDGE_SPEECH_URL=http://localhost:8089
# Local model choices (defaults shown):
# RINGBRIDGE_LOCAL_LLM=qwen2.5:3b
# RINGBRIDGE_LOCAL_STT=Systran/faster-whisper-base
# RINGBRIDGE_LOCAL_TTS=speaches-ai/piper-en_US-amy-low
# RINGBRIDGE_LOCAL_VOICE=amy
#
# Optional: your own hosted provider keys, named RINGBRIDGE_PROVIDER_<ID>_API_KEY.
# Agent specs never contain keys. All of these are optional.
# RINGBRIDGE_PROVIDER_OPENAI_API_KEY=
# RINGBRIDGE_PROVIDER_GROQ_API_KEY=
# RINGBRIDGE_PROVIDER_DEEPGRAM_API_KEY=
# RINGBRIDGE_PROVIDER_CARTESIA_API_KEY=
# RINGBRIDGE_PROVIDER_SARVAM_API_KEY=
