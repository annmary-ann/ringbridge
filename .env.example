# Copy to .env and adjust. .env is gitignored: never commit real keys.
# Values below match the local dev stack in compose.yaml (development-only credentials).

# ---------- LiveKit ----------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-devsecret

# ---------- Database ----------
RINGBRIDGE_DATABASE_URL=postgresql://ringbridge:ringbridge@localhost:5435/ringbridge

# ---------- Object storage (any S3-compatible service; ADR-0015) ----------
RINGBRIDGE_S3_ENDPOINT=http://localhost:8333
RINGBRIDGE_S3_BUCKET=ringbridge-recordings
RINGBRIDGE_S3_REGION=us-east-1
RINGBRIDGE_S3_ACCESS_KEY=ringbridge
RINGBRIDGE_S3_SECRET_KEY=ringbridge-dev-only

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4322
OTEL_SERVICE_NAME=ringbridge

# ---------- Host port overrides for the dev stack (defaults shown) ----------
# RINGBRIDGE_DB_PORT=5435
# RINGBRIDGE_REDIS_PORT=6385
# RINGBRIDGE_LIVEKIT_PORT=7880
# RINGBRIDGE_LIVEKIT_TCP_PORT=7881
# RINGBRIDGE_LIVEKIT_UDP_PORT=7882
# RINGBRIDGE_SIP_PORT=5060
# RINGBRIDGE_S3_PORT=8333
# RINGBRIDGE_JAEGER_UI_PORT=16688
# RINGBRIDGE_OTLP_GRPC_PORT=4321
# RINGBRIDGE_OTLP_HTTP_PORT=4322

